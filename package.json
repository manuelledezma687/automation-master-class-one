  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:login": "playwright test --grep @login",
    "test:smoke": "playwright test --grep @smoke",
    "test:prod": "playwright test --grep @prod",
    "test:chromium": "playwright test tests/login.spec.ts --project=chromium",
    "test:safari": "playwright test tests/login.spec.ts --project=safari",
    "report": "playwright show-report",
    "bdd": "bddgen && playwright test --project=bdd",
    "bdd:smoke": "bddgen && playwright test --project=bdd --grep @smoke",
    "bdd:login": "bddgen && playwright test --project=bdd --grep @login",
    "bdd:negative": "bddgen && playwright test --project=bdd --grep @negative",
    "bdd:table": "bddgen && playwright test --project=bdd --grep @table",
    "bdd:visual": "bddgen && playwright test --project=bdd --grep @visual"
  },
